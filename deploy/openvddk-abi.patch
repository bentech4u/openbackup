 /* VixError definition: 64-bit status code */
 typedef uint64_t VixError;
 
+/* Returned by ReadAsync/WriteAsync when the request was queued; the result
+ * is delivered to the completion callback (VMware VDDK semantics). */
+#ifndef VIX_ASYNC
+#define VIX_ASYNC ((VixError)25000)
+#endif
+
 /* Sector offset/count type */
 typedef uint64_t VixDiskLibSectorType;
 
@@ -246,6 +252,11 @@ typedef struct {
     VixDiskLibAdapterType adapterType;
     int32_t numLinks;
     char *parentFileNameHint;
+    /* Present in VMware's struct since VDDK 7; callers that see library
+     * version >= 7 read them. */
+    char *uuid;
+    uint32_t logicalSectorSize;
+    uint32_t physicalSectorSize;
 } VixDiskLibDiskInfo;
 
