# /etc/openbackup/openbackup.env — read by both services and the CLI.

# Local state: database and chunk index caches. Keep on local disk, never NFS.
OPENBACKUP_DATA_DIR=/var/lib/openbackup
OPENBACKUP_SECRET_KEY_FILE=/etc/openbackup/secret.key

# NFS repositories are mounted below this directory.
OPENBACKUP_MOUNT_ROOT=/mnt/openbackup

# Disk access: nbdkit's vddk plugin, with OpenVDDK (or VMware's VDDK) here.
OPENBACKUP_NBDKIT=nbdkit
OPENBACKUP_VDDK_LIBDIR=/opt/openvddk

# Web sessions.
OPENBACKUP_COOKIE_SECURE=true
OPENBACKUP_SESSION_IDLE_MINUTES=480
OPENBACKUP_LOGIN_MAX_FAILURES=5
OPENBACKUP_LOGIN_LOCKOUT_MINUTES=15

# Tasks against different repositories that may run at once.
OPENBACKUP_WORKER_CONCURRENCY=2
