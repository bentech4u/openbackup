# Copy to lab.env and fill in. lab.env is gitignored.
VCENTER_HOST=vcenter.example.local
VCENTER_USER=openbackup@vsphere.local
VCENTER_PASS=
# A disposable VM: snapshots get created and deleted against it, and
# enabling CBT requires a power cycle.
TEST_VM=
# Optional: skip TLS verification for a self-signed lab certificate.
VCENTER_INSECURE=1
